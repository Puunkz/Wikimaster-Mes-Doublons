{
  "manifest_version": 3,
  "name": "WikiMasters - Mes doublons",
  "version": "1.0.0",
  "description": "Affiche les cartes en double de ta collection WikiMasters.",
  "host_permissions": [
    "https://www.wiki-masters.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}